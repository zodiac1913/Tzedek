{
  "manifest_version": 3,
  "name": "Tzedek Accessibility Checker",
  "version": "2026.7.30.1",
  "version_name": "2026.07.30.01",
  "description": "Tzedek finds accessibility issues quickly. A product of the Small-Mighty-Light framework.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Run Tzedek"
  },
  "background": {
    "scripts": [
      "service-worker.js"
    ],
    "service_worker": "service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tzedek@small-mighty-light.dev",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "debugger"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page/smlCompliance.js",
        "page/smlComplianceRunner.js",
        "page/assets/Tzedek.css",
        "page/assets/smoke.png",
        "page/assets/issue-guide.html",
        "page/assets/tzedekIssueGuideData.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}